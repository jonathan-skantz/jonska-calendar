# SITE_ADDRESS is a domain in production, which turns on automatic HTTPS.
# The default serves plain HTTP on port 80 for a local check.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# The page loads only its own files and Google Fonts. React sets inline
	# styles through the DOM, which style-src does not restrict.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	# The app routes on the client, so unknown paths get index.html.
	handle {
		root * /srv
		# Built assets have a content hash in their name, so they never
		# change. Everything else, index.html above all, is checked on each
		# load, so a deploy is picked up at once.
		@assets path /assets/*
		@notAssets not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @notAssets Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
