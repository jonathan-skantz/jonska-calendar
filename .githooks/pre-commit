#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

echo "Formatting staged files..."
mise exec -- frontend/node_modules/.bin/lint-staged --config .lintstagedrc.json

# Every tracked shell script, on every commit. CI runs the same command.
echo "Running shellcheck..."
git ls-files -z '*.sh' .githooks/pre-commit | xargs -0 mise exec -- shellcheck

echo "Running Go vet..."
(cd backend && mise exec -- go vet ./...)

echo "Running Go tests..."
(cd backend && mise exec -- go test ./... -count=1)

echo "Running frontend lint..."
(cd frontend && mise exec -- npm run lint)

echo "Running frontend tests..."
(cd frontend && mise exec -- npm run test)

echo "Building frontend..."
(cd frontend && mise exec -- npm run build)
